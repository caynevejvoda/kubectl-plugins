#!/usr/bin/env bash
# kubectl-create-secret: Interactive Kubernetes secret creator
# This script provides a user-friendly way to create generic secrets
# using gum for input prompts and gum for namespace selection.

set -euo pipefail

# Terminal color codes for formatted output
BOLD='\e[1m'
RED='\e[31m'
GREEN='\e[32m'
BLUE='\e[34m'
RESET='\e[0m'

# gum configuration with Catppuccin Mocha color scheme
# Sets up the fuzzy finder with custom theming for better UX
FILTER="gum filter \
	--prompt.foreground=#89b4fa \
	--cursor-text.foreground=#89b4fa \
	--indicator.foreground=#89b4fa \
	--match.foreground=#89b4fa"
INPUT="gum input \
	--prompt.foreground=#89b4fa \
	--cursor.foreground=#89b4fa"

# error: Display an error message and exit with status 1
# Args:
#   $1 - Error message to display
error() {
	echo -e "${BOLD}${RED}ERROR${RESET} $1" >&2
	exit 1
}

# info: Display an informational message
# Args:
#   $1 - Info message to display
info() {
	echo -e "${BOLD}${BLUE}INFO${RESET} $1"
}

# success: Display a success message
# Args:
#   $1 - Success message to display
success() {
	echo -e "${BOLD}${GREEN}SUCCESS${RESET} $1"
}

# checkDependencies: Verify required commands are installed
# Checks for: kubectl, gum, and gum
# Exits with error if any dependency is missing
checkDependencies() {
	if ! command -v kubectl &>/dev/null; then
		error "kubectl is not installed"
	fi

	if ! command -v gum &>/dev/null; then
		error "gum is not installed. Install it from: https://github.com/junegunn/gum"
	fi

	if ! command -v gum &>/dev/null; then
		error "gum is not installed. Install it from: https://github.com/charmbracelet/gum"
	fi
}

# getSecretName: Prompt user for secret name
# Returns: The secret name entered by the user
# Exits with error if user cancels or provides empty input
getSecretName() {
	local secret_name
	
	if ! secret_name="$($INPUT --placeholder='Secret name')"; then
		error "Secret name input cancelled"
	fi
	
	# Trim whitespace and validate
	secret_name="${secret_name// /}"
	if [[ -z "$secret_name" ]]; then
		error "Secret name cannot be empty"
	fi
	
	echo "$secret_name"
}

# selectNamespace: Interactively select namespace using gum
# Returns: The name of the selected namespace
# Exits with error if namespace retrieval or selection fails
selectNamespace() {
	local namespaces namespace
	
	# Get all available namespaces in the current context
	if ! namespaces="$(kubectl get ns -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')"; then
		error "Failed to get namespaces"
	fi
	
	# Let user select a namespace using gum
	if ! namespace="$(echo "$namespaces" | $FILTER --prompt='namespace> ')"; then
		error "Namespace selection cancelled"
	fi
	
	echo "$namespace"
}

# collectKeyValuePairs: Interactively collect key/value pairs from user
# Returns: Array of --from-literal arguments via global array
# Populates the global LITERALS array with key=value pairs
collectKeyValuePairs() {
	LITERALS=()
	local key value
	
	while true; do
		# Get key
		if ! key="$(gum input --placeholder "Key")"; then
			if [[ ${#LITERALS[@]} -eq 0 ]]; then
				error "Key input cancelled. At least one key/value pair is required"
			else
				# User cancelled, but we have at least one pair
				break
			fi
		fi
		
		# Trim whitespace
		key="${key//[[:space:]]/}"
		if [[ -z "$key" ]]; then
			error "Key cannot be empty"
		fi
		
		# Get value (using password mode to hide sensitive data)
		if ! value="$(gum input --password --placeholder "Value for key '$key'")"; then
			error "Value input cancelled"
		fi
		
		# Note: We don't trim whitespace from values as they might be intentional
		if [[ -z "$value" ]]; then
			error "Value cannot be empty"
		fi
		
		# Add to literals array
		LITERALS+=("--from-literal=${key}=${value}")
		
		# Ask if user wants to add another key/value pair
		if gum confirm "Add another key/value pair?"; then
			continue
		else
			break
		fi
	done
	
	# Validate we have at least one pair
	if [[ ${#LITERALS[@]} -eq 0 ]]; then
		error "At least one key/value pair is required"
	fi
}

# createSecret: Create the Kubernetes secret with collected data
# Args:
#   $1 - Secret name
#   $2 - Namespace
#   ${@:3} - Array of --from-literal arguments
createSecret() {
	local secret_name="$1"
	local namespace="$2"
	shift 2
	local literals=("$@")
	
	info "Creating secret '$secret_name' in namespace '$namespace'..."
	
	if kubectl create secret generic "$secret_name" -n "$namespace" "${literals[@]}"; then
		success "Secret '$secret_name' created successfully in namespace '$namespace'"
		info "Verify with: kubectl get secret '$secret_name' -n '$namespace' -o yaml"
	else
		error "Failed to create secret '$secret_name'"
	fi
}

# main: Orchestrate the secret creation workflow
# 1. Checks dependencies
# 2. Prompts for secret name
# 3. Prompts for namespace selection
# 4. Collects key/value pairs
# 5. Creates the secret
main() {
	checkDependencies
	
	local secret_name namespace
	
	secret_name="$(getSecretName)"
	namespace="$(selectNamespace)"
	collectKeyValuePairs
	
	createSecret "$secret_name" "$namespace" "${LITERALS[@]}"
}

main
