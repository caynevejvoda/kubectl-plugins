#!/usr/bin/env bash
# kubectl-create_cnpg_role_secret: Interactive CNPG role secret creator
# This script provides a user-friendly way to create secrets for CNPG
# (CloudNativePG) database roles with SCRAM-SHA-256 password hashing.

set -euo pipefail

# Terminal color codes for formatted output
BOLD='\e[1m'
RED='\e[31m'
GREEN='\e[32m'
BLUE='\e[34m'
RESET='\e[0m'

# gum configuration with Catppuccin Mocha color scheme
# Sets up the fuzzy finder with custom theming for better UX
FILTER="gum filter \
	--prompt.foreground=#89b4fa \
	--cursor-text.foreground=#89b4fa \
	--indicator.foreground=#89b4fa \
	--match.foreground=#89b4fa"
INPUT="gum input \
	--prompt.foreground=#89b4fa \
	--cursor.foreground=#89b4fa"

# Config file location following XDG spec
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kubectl-create_cnpg_role_secret"
CONFIG_FILE="$CONFIG_DIR/config"

# Default values
PREFIX=""

# error: Display an error message and exit with status 1
# Args:
#   $1 - Error message to display
error() {
	echo -e "${BOLD}${RED}ERROR${RESET} $1" >&2
	exit 1
}

# info: Display an informational message
# Args:
#   $1 - Info message to display
info() {
	echo -e "${BOLD}${BLUE}INFO${RESET} $1"
}

# success: Display a success message
# Args:
#   $1 - Success message to display
success() {
	echo -e "${BOLD}${GREEN}SUCCESS${RESET} $1"
}

# checkDependencies: Verify required commands are installed
# Checks for: kubectl, gum, scram-sha-256, base64
# Exits with error if any dependency is missing
checkDependencies() {
	if ! command -v kubectl &>/dev/null; then
		error "kubectl is not installed"
	fi

	if ! command -v gum &>/dev/null; then
		error "gum is not installed. Install it from: https://github.com/charmbracelet/gum"
	fi

	if ! command -v scram-sha-256 &>/dev/null; then
		error "scram-sha-256 is not installed. Install it from: https://github.com/supercaracal/scram-sha-256"
	fi

	if ! command -v base64 &>/dev/null; then
		error "base64 is not installed"
	fi
}

# loadConfig: Load configuration from config file if it exists
# Reads PREFIX variable from the config file
loadConfig() {
	if [[ -f "$CONFIG_FILE" ]]; then
		# shellcheck source=/dev/null
		source "$CONFIG_FILE"
		if [[ -n "$PREFIX" ]]; then
			info "Using prefix from config: '$PREFIX'"
		fi
	fi
}

# selectNamespace: Interactively select namespace using gum
# Returns: The name of the selected namespace
# Exits with error if namespace retrieval or selection fails
selectNamespace() {
	local namespaces namespace

	# Get all available namespaces in the current context
	if ! namespaces="$(kubectl get ns -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')"; then
		error "Failed to get namespaces"
	fi

	# Let user select a namespace using gum
	if ! namespace="$(echo "$namespaces" | $FILTER --prompt='namespace> ')"; then
		error "Namespace selection cancelled"
	fi

	echo "$namespace"
}

# getSecretName: Prompt user for secret name
# Returns: The full secret name (with prefix if configured)
# Exits with error if user cancels or provides empty input
getSecretName() {
	local secret_name

	if ! secret_name="$($INPUT --placeholder='Secret name')"; then
		error "Secret name input cancelled"
	fi

	# Trim whitespace and validate
	secret_name="${secret_name// /}"
	if [[ -z "$secret_name" ]]; then
		error "Secret name cannot be empty"
	fi

	# Prepend prefix if configured
	echo "${PREFIX}${secret_name}"
}

# getUsername: Prompt user for database username
# Returns: The username entered by the user
# Exits with error if user cancels or provides empty input
getUsername() {
	local username

	if ! username="$($INPUT --placeholder='Database username')"; then
		error "Username input cancelled"
	fi

	# Trim whitespace and validate
	username="${username// /}"
	if [[ -z "$username" ]]; then
		error "Username cannot be empty"
	fi

	echo "$username"
}

# getPassword: Prompt user for password (hidden input)
# Returns: The password entered by the user
# Exits with error if user cancels or provides empty input
getPassword() {
	local password

	if ! password="$($INPUT --password --placeholder='Password (will be hashed with SCRAM-SHA-256)')"; then
		error "Password input cancelled"
	fi

	if [[ -z "$password" ]]; then
		error "Password cannot be empty"
	fi

	echo "$password"
}

# askReloadLabel: Ask user if the cnpg.io/reload label should be true or false
# Returns: "true" or "false"
askReloadLabel() {
	if gum confirm "Enable cnpg.io/reload label? (triggers secret reload in CNPG)"; then
		echo "true"
	else
		echo "false"
	fi
}

# hashPassword: Hash password using SCRAM-SHA-256
# Args:
#   $1 - Plain text password
# Returns: The SCRAM-SHA-256 hashed password
hashPassword() {
	local password="$1"
	local hashed

	if ! hashed="$(echo -n "$password" | scram-sha-256)"; then
		error "Failed to hash password with SCRAM-SHA-256"
	fi

	echo "$hashed"
}

# createSecret: Create the Kubernetes secret with CNPG format
# Args:
#   $1 - Secret name
#   $2 - Namespace
#   $3 - Username
#   $4 - Hashed password
#   $5 - Reload label value ("true" or "false")
createSecret() {
	local secret_name="$1"
	local namespace="$2"
	local username="$3"
	local hashed_password="$4"
	local reload_label="$5"

	# Base64 encode the values (use -w 0 to prevent line wrapping)
	local encoded_username encoded_password
	encoded_username="$(echo -n "$username" | base64 -w 0)"
	encoded_password="$(echo -n "$hashed_password" | base64 -w 0)"

	info "Creating secret '$secret_name' in namespace '$namespace'..."

	if kubectl create -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: $secret_name
  namespace: $namespace
  labels:
    cnpg.io/reload: "$reload_label"
type: Opaque
data:
  username: $encoded_username
  password: $encoded_password
EOF
	then
		success "Secret '$secret_name' created successfully in namespace '$namespace'"
		info "Verify with: kubectl get secret '$secret_name' -n '$namespace' -o yaml"
	else
		error "Failed to create secret '$secret_name'"
	fi
}

# main: Orchestrate the CNPG role secret creation workflow
# 1. Checks dependencies
# 2. Loads config (optional prefix)
# 3. Prompts for secret name
# 4. Prompts for namespace selection
# 5. Prompts for username
# 6. Prompts for password
# 7. Asks about reload label
# 8. Hashes password
# 9. Creates the secret
main() {
	checkDependencies
	loadConfig

	local secret_name namespace username password reload_label hashed_password

	secret_name="$(getSecretName)"
	namespace="$(selectNamespace)"
	username="$(getUsername)"
	password="$(getPassword)"
	reload_label="$(askReloadLabel)"
	hashed_password="$(hashPassword "$password")"

	createSecret "$secret_name" "$namespace" "$username" "$hashed_password" "$reload_label"
}

main
