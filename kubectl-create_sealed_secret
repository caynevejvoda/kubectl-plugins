#!/usr/bin/env bash
# kubectl-create_sealed_secret: Interactive SealedSecret manifest creator
# Uses gum for prompts, kubectl client dry-run to generate the Secret,
# and kubeseal to create or merge an encrypted manifest on disk.

set -euo pipefail

# Collected --from-literal arguments, populated by collectKeyValuePairs.
LITERALS=()

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kubectl-create_sealed_secret/config"
SEALED_SECRET_CERT="${SEALED_SECRET_CERT:-}"

# loadConfig: Load optional certificate configuration, following the XDG spec.
loadConfig() {
	if [[ -f "$CONFIG_FILE" ]]; then
		# shellcheck source=/dev/null
		source "$CONFIG_FILE"
	fi
}

# error: Log an error with gum and exit with status 1
# Args:
#   $1 - Error message to display
# Falls back to stderr output when gum itself is missing
error() {
	if command -v gum >/dev/null 2>&1; then
		gum log --level error "$1" >&2
	else
		printf 'ERROR: %s\n' "$1" >&2
	fi
	exit 1
}

# info: Log an informational message with gum on stderr
# Args:
#   $1 - Message to display
info() {
	gum log --level info "$1" >&2
}

# warning: Log a warning message with gum on stderr
# Args:
#   $1 - Message to display
warning() {
	gum log --level warn "$1" >&2
}

# usage: Display the command syntax
usage() {
	printf 'Usage: kubectl create-sealed-secret <sealed-secret.yaml>\n'
}

# validateTarget: Check that the output file or its parent is accessible
# Args:
#   $1 - Output path
# Exits with error for an invalid or inaccessible path
validateTarget() {
	local target="$1"
	if [[ -e "$target" || -L "$target" ]]; then
		[[ -f "$target" && -r "$target" && -w "$target" ]] || error "Path must be a readable, writable file: $target"
	else
		[[ -d "$(dirname -- "$target")" && -w "$(dirname -- "$target")" ]] || error "Parent directory must exist and be writable: $target"
	fi
}

# checkDependencies: Verify kubectl, gum, kubeseal and yq are installed
# Exits with error if any dependency is missing
checkDependencies() {
	local dependency
	for dependency in kubectl gum kubeseal yq; do
		command -v "$dependency" >/dev/null 2>&1 || error "$dependency is not installed"
	done
}

# selectNamespace: Select a namespace from the current context using gum
# Returns: Selected namespace on stdout
# Exits with error if retrieval fails, no namespaces exist or selection is cancelled
selectNamespace() {
	local namespaces namespace

	if ! namespaces=$(kubectl get namespaces -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'); then
		error 'Failed to get namespaces from the current context'
	fi
	[[ -n "$namespaces" ]] || error 'No namespaces available in the current context'
	if ! namespace=$(printf '%s\n' "$namespaces" | gum filter \
		--prompt.foreground='#89b4fa' --cursor-text.foreground='#89b4fa' \
		--indicator.foreground='#89b4fa' --match.foreground='#89b4fa' \
		--prompt='namespace> '); then
		error 'Namespace selection cancelled'
	fi
	[[ -n "$namespace" ]] || error 'Namespace cannot be empty'
	printf '%s\n' "$namespace"
}

# getSecretName: Prompt for and validate a Kubernetes Secret name
# Returns: Validated secret name on stdout
# Exits with error if input is cancelled or the name is invalid
getSecretName() {
	local secret_name label
	local -a labels

	if ! secret_name=$(gum input --placeholder='Secret name'); then
		error 'Secret name input cancelled'
	fi
	[[ ${#secret_name} -le 253 && "$secret_name" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || error 'Invalid secret name: use a Kubernetes DNS subdomain name'
	IFS='.' read -r -a labels <<< "$secret_name"
	for label in "${labels[@]}"; do
		[[ "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || error 'Invalid secret name: each dot-separated label must start and end with a letter or digit'
	done
	printf '%s\n' "$secret_name"
}

# getExistingSecretName: Read the name from an existing SealedSecret manifest
# Args:
#   $1 - Existing SealedSecret file path (YAML or JSON)
# Returns: Existing Secret name on stdout
# Exits with error if the file cannot be parsed or has no named SealedSecret
getExistingSecretName() {
	local target="$1"
	local existing_name

	if ! existing_name=$(yq -r 'select(.kind == "SealedSecret") | .metadata.name // empty' "$target"); then
		error "Failed to read Secret name from '$target'"
	fi
	[[ -n "$existing_name" ]] || error "No named SealedSecret found in '$target'"
	printf '%s\n' "$existing_name"
}

# getExistingNamespace: Read the namespace from an existing SealedSecret
# Args:
#   $1 - Existing SealedSecret file path (YAML or JSON)
# Returns: Namespace on stdout, or empty output when it is not set
# Exits with error if the file cannot be parsed
getExistingNamespace() {
	local target="$1"

	if ! yq -r '.metadata.namespace // empty' "$target"; then
		error "Failed to read namespace from '$target'"
	fi
}

# collectKeyValuePairs: Prompt for at least one key/value pair
# Args:
#   $1 - Output path, used to check keys in an existing SealedSecret
# Populates the global LITERALS array with --from-literal arguments
# Values are hidden during input; empty values are allowed
# The prompt to add another pair defaults to No
# Existing or already collected keys require confirmation before replacement
# Declining replacement returns to the key prompt without asking for a value
# Exits with error for invalid keys, unreadable existing keys or cancelled input
collectKeyValuePairs() {
	local target="$1"
	local key value status saved_keys existing_key
	local -A keys=()
	local -A existing_keys=()

	if [[ -f "$target" ]]; then
		if ! saved_keys=$(yq -r '(.spec.encryptedData // {}) | keys[]' "$target"); then
			error "Failed to read existing Secret keys from '$target'"
		fi
		while IFS= read -r existing_key; do
			[[ -z "$existing_key" ]] || existing_keys["$existing_key"]=1
		done <<< "$saved_keys"
	fi

	LITERALS=()
	while true; do
		if ! key=$(gum input --placeholder='Key'); then
			error 'Key input cancelled'
		fi
		[[ ${#key} -le 253 && "$key" =~ ^[a-zA-Z0-9._-]+$ ]] || error 'Keys must contain 1-253 letters, digits, dots, underscores or hyphens'
		if [[ -v existing_keys["$key"] || -v keys["$key"] ]]; then
			warning "Key '$key' already exists"
			if gum confirm --default=false "Replace existing key '$key'?"; then
				:
			else
				status=$?
				[[ $status -eq 1 ]] || error 'Key replacement cancelled'
				continue
			fi
		fi
		if ! value=$(gum input --password --char-limit=0 --placeholder="Value for key '$key'"); then
			error 'Value input cancelled'
		fi
		if [[ -v keys["$key"] ]]; then
			LITERALS[${keys["$key"]}]="--from-literal=$key=$value"
		else
			keys["$key"]=${#LITERALS[@]}
			LITERALS+=("--from-literal=$key=$value")
		fi
		if gum confirm --default=false 'Add another key/value pair?'; then
			continue
		else
			status=$?
			[[ $status -eq 1 ]] || error 'Key/value collection cancelled'
			break
		fi
	done
}

# generateSecret: Generate an unsealed Secret manifest without creating it
# Args:
#   $1 - Secret name
#   $2 - Namespace
#   ${@:3} - --from-literal arguments
# Returns: Secret YAML on stdout, with base64-encoded data
# Exits with error if kubectl client dry-run fails
generateSecret() {
	local secret_name="$1"
	local namespace="$2"
	shift 2

	if ! kubectl create secret generic "$secret_name" \
		--namespace "$namespace" "$@" --dry-run=client -o yaml; then
		error 'Failed to generate Secret YAML'
	fi
}

# colorSecretPreview: Color stringData entries in a generated YAML preview
# Args:
#   $1 - Preview YAML generated by yq
#   ${@:2} - --from-literal arguments identifying new or replaced keys
# Returns: YAML with unchanged entries orange and new/replaced entries green
# Multiline value continuations inherit the color of their key
colorSecretPreview() {
	local preview="$1"
	shift
	local literal key line color=''
	local in_data=false
	local -A changed_keys=()
	local orange=$'\033[38;2;250;179;135m'
	local green=$'\033[38;2;166;227;161m'
	local reset=$'\033[0m'

	for literal in "$@"; do
		key=${literal#--from-literal=}
		changed_keys["${key%%=*}"]=1
	done
	while IFS= read -r line; do
		if [[ "$line" == 'stringData:' ]]; then
			in_data=true
			color=''
		elif [[ "$line" =~ ^[^[:space:]] ]]; then
			in_data=false
			color=''
		elif [[ "$in_data" == true && "$line" =~ ^\ \ ([^[:space:]][^:]*): ]]; then
			key=${BASH_REMATCH[1]}
			# yq may quote keys such as 'true' or '123'.
			key=${key#\'}
			key=${key%\'}
			key=${key#\"}
			key=${key%\"}
			color=$orange
			[[ ! -v changed_keys["$key"] ]] || color=$green
		fi
		if [[ -n "$color" ]]; then
			printf '%s%s%s\n' "$color" "$line" "$reset"
		else
			printf '%s\n' "$line"
		fi
	done <<< "$preview"
}

# printSecret: Print a readable YAML preview with decoded stringData values
# Args:
#   $1 - Unsealed Secret YAML with base64-encoded data
#   $2 - Output path, used to include existing keys when merging
# Returns: YAML with plaintext stringData and placeholders for unchanged keys
# New or replaced values take precedence over encrypted placeholders
# Terminal output colors unchanged entries orange and new/replaced entries green
# Redirected output remains plain YAML
# Exits with error if reading, decoding or YAML conversion fails
printSecret() {
	local plaintext="$1"
	local target="$2"
	local existing_data='{}'
	local preview

	if [[ -f "$target" ]]; then
		if ! existing_data=$(yq -c '(.spec.encryptedData // {}) | map_values("already exists/encrypted")' "$target"); then
			error "Failed to read existing Secret keys from '$target' for preview"
		fi
	fi

	# $existing is a jq variable supplied by --argjson.
	# shellcheck disable=SC2016
	if ! preview=$(printf '%s\n' "$plaintext" | yq -y --argjson existing "$existing_data" \
		'.stringData = ($existing + ((.data // {}) | with_entries(.value |= @base64d))) | del(.data)'); then
		error 'Failed to decode Secret YAML for preview'
	fi
	if [[ -t 1 ]]; then
		colorSecretPreview "$preview" "${LITERALS[@]}"
	else
		printf '%s\n' "$preview"
	fi
}

# createSealedSecret: Encrypt the Secret and write or merge the output file
# Args:
#   $1 - Output path
#   $2 - Whether to merge into an existing file (true or false)
#   $3 - Unsealed Secret YAML
# Preserves the existing encryption scope when merging
# Exits with error if sealing fails; removes staged output on exit
createSealedSecret() {
	local target="$1"
	local merge="$2"
	local plaintext="$3"
	local temporary scope
	local -a cert_args=()
	if [[ -n "${SEALED_SECRET_CERT:-}" ]]; then
		cert_args=(--cert "$SEALED_SECRET_CERT")
	fi
	if [[ "$merge" == true ]]; then
		if ! scope=$(yq -r '
			if .metadata.annotations["sealedsecrets.bitnami.com/cluster-wide"] == "true" then
				"cluster-wide"
			elif .metadata.annotations["sealedsecrets.bitnami.com/namespace-wide"] == "true" then
				"namespace-wide"
			else
				"strict"
			end' "$target"); then
			error "Failed to read encryption scope from '$target'"
		fi
		if ! printf '%s\n' "$plaintext" | kubeseal "${cert_args[@]}" --scope "$scope" --merge-into "$target"; then
			error 'Failed to merge sealed secret'
		fi
	else
		# Stage encrypted output so a sealing failure does not leave a partial file.
		umask 077
		temporary=$(mktemp "$(dirname -- "$target")/.sealed-secret.XXXXXX")
		trap 'rm -f -- "$temporary"' EXIT
		if ! printf '%s\n' "$plaintext" | kubeseal "${cert_args[@]}" > "$temporary"; then
			error 'Failed to seal secret'
		fi
		mv -- "$temporary" "$target"
		trap - EXIT
	fi
	info "Sealed secret saved to $target"
}

# main: Orchestrate interactive SealedSecret creation
# Args:
#   $1 - Required output path, or --help/-h
# 1. Validates arguments, the output path and dependencies
# 2. Reuses the existing SealedSecret name and namespace where available,
#    prompts for missing values, then collects key/value pairs
# 3. Generates and displays the unsealed Secret YAML for confirmation
# 4. Encrypts the Secret and creates or merges the output file
main() {
	local target secret_name plaintext
	local namespace=''
	local merge=false

	if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then
		usage
		exit 0
	fi
	if [[ $# -ne 1 || -z "$1" ]]; then
		usage >&2
		exit 1
	fi

	target=$1
	# Prefix relative paths so filenames beginning with '-' remain ordinary paths.
	[[ "$target" == /* ]] || target="./$target"
	validateTarget "$target"
	if [[ -e "$target" || -L "$target" ]]; then
		merge=true
	fi
	checkDependencies
	loadConfig

	if [[ "$merge" == true ]]; then
		secret_name="$(getExistingSecretName "$target")"
		info "Using existing Secret name: $secret_name"
		namespace="$(getExistingNamespace "$target")"
		if [[ -n "$namespace" ]]; then
			info "Using existing namespace: $namespace"
		fi
	fi
	if [[ -z "$namespace" ]]; then
		namespace="$(selectNamespace)"
	fi
	if [[ "$merge" == false ]]; then
		secret_name="$(getSecretName)"
	fi
	collectKeyValuePairs "$target"
	plaintext="$(generateSecret "$secret_name" "$namespace" "${LITERALS[@]}")"

	info 'Plaintext Secret YAML:'
	printSecret "$plaintext" "$target"
	if ! gum confirm "Create sealed secret '$secret_name' in '$target'?"; then
		info 'Cancelled.'
		exit 0
	fi

	createSealedSecret "$target" "$merge" "$plaintext"
}

main "$@"
